# Copie para .env e preencha com os valores do seu projeto Supabase
# (Project Settings > API, no dashboard). Nunca commitar o .env real.

# Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project Settings > API > Project API keys > anon public
# Único valor exposto ao client (browser) — ver CLAUDE.md, seção 28.
SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > service_role
# NUNCA exposto ao client — só usado em server/utils/supabase-admin.ts
# (CLAUDE.md, seção 4.5/28).
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > General > Reference ID — usado por `supabase link`
# e para gerar app/types/database.types.ts.
SUPABASE_PROJECT_REF=

# Upstash Redis (console.upstash.com) — store durável e compartilhado entre
# instâncias serverless, usado pelo rate limiting de endpoints públicos
# sensíveis (CLAUDE.md, seção 3/14.5/28: rsvp/[code], gifts/[id]/reserve).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chave de 32 bytes (hex de 64 chars ou qualquer string) para assinar (HMAC-
# SHA256) o cookie de sessão do RSVP (server/utils/rsvp-session.ts) — emitido
# depois que o convidado se identifica (link direto ou busca por nome +
# "Sim, sou eu"), exigido pelas rotas de mutação do RSVP. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA commitar; vive só no ambiente do servidor.
RSVP_SESSION_SECRET=

# URL pública estável do site (sem barra final) — usada para montar
# redirect_url/webhook_url absolutos no checkout Pix da InfinitePay
# (CLAUDE.md, seção 18/28). Em produção, o domínio real; em dev, o webhook
# só é alcançável pela InfinitePay se o host for público (ex.: túnel).
NUXT_SITE_URL=http://localhost:3000

# --- Galeria via Google Drive (CLAUDE.md, Fase Galeria via Google Drive) ---

# OAuth do Google (Google Cloud Console > APIs & Services > Credentials).
# CLIENT_ID é público (usado client-side pelo Google Identity Services/Picker,
# exposto em runtimeConfig.public); CLIENT_SECRET é server-only (troca do
# código de autorização por refresh token).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# API key do projeto (Google Cloud Console) usada para listar uma pasta
# pública ("qualquer pessoa com o link") no modo link público — sem OAuth do
# usuário. Server-only. Restrinja a key à Drive API no console. Limitação: a
# cota dessa key é COMPARTILHADA entre todos os casamentos nesse modo.
GOOGLE_DRIVE_API_KEY=

# developerKey do Google Picker (client-side, público por design — restrinja
# no console). Pode ser a mesma da GOOGLE_DRIVE_API_KEY se as restrições
# permitirem; separada aqui para poder restringir cada uma ao seu uso.
GOOGLE_PICKER_API_KEY=

# Chave de 32 bytes (hex de 64 chars ou base64) para cifrar os tokens OAuth
# em repouso (AES-256-GCM, server/utils/token-cipher.ts). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA commitar; vive só no ambiente do servidor (nunca no banco).
DRIVE_TOKEN_ENCRYPTION_KEY=

# Chave de 32 bytes (mesmo formato acima) para cifrar o código de acesso
# do convite em repouso. Separada da DRIVE_TOKEN_ENCRYPTION_KEY de
# propósito: rotacionar ou comprometer uma não afeta a outra. Sem ela, o
# painel não consegue reexibir o link/QR de um convite já gerado.
ACCESS_CODE_ENCRYPTION_KEY=

# Segredo do cron de sincronização da galeria (Vercel Cron envia
# `Authorization: Bearer $CRON_SECRET` automaticamente quando esta env existe).
# GET /api/cron/sync-galleries recusa qualquer chamada sem esse header.
CRON_SECRET=

# --- Localização do cronograma (CLAUDE.md, seção 12) ---

# API key do Google com a "Places API (New)" habilitada — autocomplete de
# locais no cadastro de Cerimônia/Recepção. Server-only: o navegador nunca vê
# essa chave, toda busca passa por /api/places/** (diferente da
# GOOGLE_PICKER_API_KEY, que é client-side por design).
# Exige faturamento ativo no projeto do Google Cloud. Restrinja a key à
# Places API no console; como ela não sai do servidor, use restrição por IP
# ou nenhuma, nunca por referrer HTTP.
# OPCIONAL: sem ela, o campo de busca some e o cadastro de local funciona
# inteiro pelo caminho manual (endereço digitado + marcador no mapa) — o
# embed do mapa no site público continua sem chave nenhuma, como sempre foi.
GOOGLE_MAPS_API_KEY=

# --- Testes E2E (Playwright) ---

# Usuário administrativo real, já vinculado como membro em membros_casamento
# do projeto Supabase configurado acima — não há signup self-service, então
# essa conta é provisionada à mão (Authentication > Users no dashboard, e
# depois um INSERT em membros_casamento com o casamento_id de teste).
# Sem essas duas variáveis, os specs que passam pelo login (login.spec.ts,
# casamento-ativo.spec.ts, guests-invites-rsvp.spec.ts) são PULADOS em vez
# de falharem — e nenhuma verificação visual de /admin é possível, porque o
# painel inteiro fica atrás de sessão autenticada.
# Use sempre o projeto Supabase de desenvolvimento: os specs criam e apagam
# convidados/convites de verdade.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
