# Copie para .env e preencha com os valores do seu projeto Supabase
# (Project Settings > API, no dashboard). Nunca commitar o .env real.

# Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project Settings > API > Project API keys > anon public
# Único valor exposto ao client (browser) — ver CLAUDE.md, seção 28.
SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > service_role
# NUNCA exposto ao client — só usado em server/utils/supabase-admin.ts
# (CLAUDE.md, seção 4.5/28).
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > General > Reference ID — usado por `supabase link`
# e para gerar app/types/database.types.ts.
SUPABASE_PROJECT_REF=

# Upstash Redis (console.upstash.com) — store durável e compartilhado entre
# instâncias serverless, usado pelo rate limiting de endpoints públicos
# sensíveis (CLAUDE.md, seção 3/14.5/28: rsvp/[code], gifts/[id]/reserve).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
